rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for admin authorization check
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'yared.abegaz@gmail.com';
    }

    // Products collection: publicly readable, admin writable
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection: publicly readable, admin writable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection: writable by anyone submitting an inquiry, admin readable/updatable/deletable
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
